PORT=3030
TIMEZONE=Asia/Kolkata
# PostgreSQL connection for the isolated `joe` schema in svt-ppf-db.
# Joe falls back to local demo storage when this is unset.
DATABASE_URL=
DATABASE_SSL=false
JOE_WORKSPACE_ID=b7abfc76-5f38-4b28-a5fa-2db9b5c282ef
JOE_WORKSPACE_SLUG=joe-demo
JOE_WORKSPACE_NAME=Joe Demo
# Digits-only shared Joe number, used only when generating business entry links.
JOE_WHATSAPP_NUMBER=
# Set true when every new lead must enter via JOIN <workspace-slug>.
REQUIRE_WORKSPACE_CODE=true
# Lets the shared Joe number answer sales enquiries arriving without a business
# workspace code. Azure OpenAI qualifies real business enquiries before Joe
# offers a demo; it never books a call without explicit confirmation.
JOE_SALES_MODE=true
# Internal recipient for Joe product-demo calendar invitations. Falls back to
# MAIN_USER_EMAIL when blank.
JOE_SALES_CALENDAR_EMAIL=
# Set this to /var/data on Render, which has a persistent disk mounted there.
PERSISTENT_DATA_DIR=
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/replace-me

# One-calendar demo: only this user's events can create WhatsApp reminders.
ADMIN_WHATSAPP_JID=9198XXXXXXXX@s.whatsapp.net
MAIN_USER_EMAIL=customer@example.com

# Optional fallback when QR linking is blocked. Use digits only, including country code.
PAIRING_PHONE_NUMBER=

# Required in production to protect /qr and /daily-brief.
DASHBOARD_TOKEN=replace-with-a-long-random-token

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=
